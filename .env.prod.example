# Production. Copy to .env.prod and fill in. NEVER commit .env.prod.
NODE_ENV=production
PORT=4000

# Atlas connection string, not localhost.
MONGODB_URI=

# At least 32 characters — the server refuses to start below that in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required in production. Comma-separated, no trailing slash.
CORS_ORIGIN=https://octava.ba
APP_URL=https://octava.ba

# console does not send mail; production refuses to start with it.
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=

# Optional. Empty means the feature is simply unavailable.
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=

# Without BACKUP_KEY the backups are written unencrypted.
BACKUP_DIR=
BACKUP_KEY=
BACKUP_KEEP_DAYS=14
