{
  "name": "octava-backend",
  "version": "1.0.0",
  "description": "Octava - Balkan guitar chords API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "master": "node scripts/daemons/start_overnight_master.js",
    "healer": "node scripts/daemons/continuous_quality_healer.js",
    "watch:healer": "tail -f logs/healer_live.log",
    "backup": "node scripts/maintenance/backup.js",
    "restore": "node scripts/maintenance/restore.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js"
  },
  "keywords": [
    "guitar",
    "chords",
    "balkan",
    "music"
  ],
  "author": "Mirnes Solak",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.3"
  }
}
