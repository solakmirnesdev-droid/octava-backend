MONGODB_URI=mongodb://localhost:27017/octava
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# 5000 is deliberately left free for the RareCarat SSR server.
PORT=4000

# octava-app on 3000, octava-dashboard on 8000.
#
# The native shell has its own origin and the API has never seen it. If a
# Capacitor build is in play, add capacitor://localhost (iOS) and
# https://localhost (Android) or every request fails before it is read.
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

# Where the site lives, for links inside emails. A password-reset mail built
# against the wrong host sends people somewhere that cannot honour the token.
APP_URL=http://localhost:3000

# Google sign-in. Empty = the button never renders. The backend verifies the
# token against this same id, so it must match NUXT_PUBLIC side for nothing —
# the app reads it from /api/auth/google/status, not from its own config.
# Get one at console.cloud.google.com → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile, secret half. Empty = verification is SKIPPED and the
# CAPTCHA protects nothing. The server warns about this at startup in production.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- the paywall
# Off entirely, and every sheet is public.
PAYWALL_ENABLED=true

# What the wall asks for:
#   account       signing in is enough — where this stands now, because
#                 payments are not designed yet
#   subscription  the reader must have paid
# The subscription path stays covered by tests either way, so it does not rot
# while it is switched off.
PAYWALL_REQUIRES=account

# simulated  the subscribe endpoint grants a period without taking money
# disabled   it refuses, which is what production wants until a processor exists
PAYMENTS_MODE=simulated

# ------------------------------------------------------------------- sessions
# How long a dashboard session lasts with nobody touching it. The client renews
# while somebody works, so this is reached only by going idle.
STAFF_SESSION_MINUTES=60

# --------------------------------------------------------------------- e-mail
# console  prints the message and its links to stdout, delivers nothing
# resend   really sends, and needs the key below
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=Octava <noreply@octava.example>

# -------------------------------------------------------------------- backups
# scripts/backup.js writes here. Under systemd this path must also appear in
# ReadWritePaths= or the write fails with EROFS and reads as a disk fault.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# Encrypts the dump. It contains TOTP secrets, and anyone holding one can
# generate valid second-factor codes indefinitely. Empty = written in the clear.
BACKUP_KEY=

# ---------------------------------------------------------------------- misc
# Oldest mobile build the API will still answer, reported by /version. Lets an
# old release be cut off without shipping a server change.
MINIMUM_CLIENT=

# Returned by /version as `notice`, for a client to show. Empty = no notice.
SERVICE_NOTICE=

# Chat messages per minute, per staff account.
CHAT_SEND_LIMIT=30
